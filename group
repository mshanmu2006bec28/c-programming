#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Character comparison for sorting individual strings
int cmpChar(const void* a, const void* b) {
    return (*(char*)a - *(char*)b);
}

// Structure to pair a string's sorted key version with its original index
typedef struct {
    char sortedKey[101];
    int originalIdx;
} WordWrapper;

// Comparison function to group identical keys together
int cmpWrapper(const void* a, const void* b) {
    return strcmp(((WordWrapper*)a)->sortedKey, ((WordWrapper*)b)->sortedKey);
}

char*** groupAnagrams(char** strs, int strsSize, int* returnSize, int** returnColumnSizes) {
    if (strsSize == 0) {
        *returnSize = 0;
        return NULL;
    }

    // Allocate array of wrappers
    WordWrapper* wrappers = (WordWrapper*)malloc(strsSize * sizeof(WordWrapper));
    for (int i = 0; i < strsSize; i++) {
        strcpy(wrappers[i].sortedKey, strs[i]);
        // Sort characters to create an anagram signature key
        qsort(wrappers[i].sortedKey, strlen(wrappers[i].sortedKey), sizeof(char), cmpChar);
        wrappers[i].originalIdx = i;
    }

    // Sort wrappers so that all anagrams with matching keys sit next to each other
    qsort(wrappers, strsSize, sizeof(WordWrapper), cmpWrapper);

    // Count unique groups to allocate exact memory
    int groupsCount = 0;
    for (int i = 0; i < strsSize; i++) {
        if (i == 0 || strcmp(wrappers[i].sortedKey, wrappers[i - 1].sortedKey) != 0) {
            groupsCount++;
        }
    }

    // Allocate result pointers
    char*** result = (char***)malloc(groupsCount * sizeof(char**));
    *returnColumnSizes = (int*)malloc(groupsCount * sizeof(int));
    *returnSize = groupsCount;

    int currentGroup = -1;
    int currentGroupSize = 0;

    // Populate the output arrays by traversing adjacent identical keys
    for (int i = 0; i < strsSize; i++) {
        if (i == 0 || strcmp(wrappers[i].sortedKey, wrappers[i - 1].sortedKey) != 0) {
            if (currentGroup >= 0) {
                (*returnColumnSizes)[currentGroup] = currentGroupSize;
            }
            currentGroup++;
            currentGroupSize = 0;
            // Allocate initial row container slice (dynamically grow as needed)
            result[currentGroup] = (char**)malloc(strsSize * sizeof(char*));
        }
        
        int origIdx = wrappers[i].originalIdx;
        result[currentGroup][currentGroupSize] = (char*)malloc((strlen(strs[origIdx]) + 1) * sizeof(char));
        strcpy(result[currentGroup][currentGroupSize], strs[origIdx]);
        currentGroupSize++;
    }
    // Set size for final group iteration
    (*returnColumnSizes)[currentGroup] = currentGroupSize;

    // Trim rows to their exact filled size to avoid memory bloat
    for (int i = 0; i < groupsCount; i++) {
        result[i] = (char**)realloc(result[i], (*returnColumnSizes)[i] * sizeof(char*));
    }

    free(wrappers);
    return result;
}
