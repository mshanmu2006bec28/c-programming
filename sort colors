void sortColors(int* nums, int numsSize) {
    int low = 0;
    int mid = 0;
    int high = numsSize - 1;

    while (mid <= high) {
        if (nums[mid] == 0) {
            // Swap elements at mid and low
            int temp = nums[mid];
            nums[mid] = nums[low];
            nums[low] = temp;
            low++;
            mid++;
        } 
        else if (nums[mid] == 1) {
            // Element '1' is already in the correct middle region
            mid++;
        } 
        else { // nums[mid] == 2
            // Swap elements at mid and high
            int temp = nums[mid];
            nums[mid] = nums[high];
            nums[high] = temp;
            high--;
            // Do not increment mid, as the swapped element needs validation
        }
    }
}

