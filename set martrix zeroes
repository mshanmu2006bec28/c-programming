#include <stdbool.h>

void setZeroes(int** matrix, int matrixSize, int* matrixColSize) {
    int m = matrixSize;
    int n = matrixColSize[0];
    bool is_col0 = false;

    // First pass: Record status of cells in the first row and column
    for (int i = 0; i < m; i++) {
        if (matrix[i][0] == 0) {
            is_col0 = true;
        }
        for (int j = 1; j < n; j++) {
            if (matrix[i][j] == 0) {
                matrix[i][0] = 0;
                matrix[0][j] = 0;
            }
        }
    }

    // Second pass: Use markers to set elements to zero (bottom-up/right-to-left)
    for (int i = m - 1; i >= 0; i--) {
        for (int j = n - 1; j >= 1; j--) {
            if (matrix[i][0] == 0 || matrix[0][j] == 0) {
                matrix[i][j] = 0;
            }
        }
        if (is_col0) {
            matrix[i][0] = 0;
        }
    }
}
