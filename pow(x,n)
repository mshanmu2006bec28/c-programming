#include <stdio.h>
double myPow(double x, int n) {
    // Use a long long to prevent integer overflow when n = -2^31
    long long abs_n = n;
    
    // If the exponent is negative, invert the base and make the exponent positive
    if (abs_n < 0) {
        x = 1.0 / x;
        abs_n = -abs_n;
    }

    double result = 1.0;
    double current_product = x;

    // Iterative Binary Exponentiation
    while (abs_n > 0) {
        // If the current exponent bit is odd, multiply the result by current_product
        if (abs_n % 2 == 1) {
            result *= current_product;
        }
        // Square the base product and shift the exponent right (divide by 2)
        current_product *= current_product;
        abs_n /= 2;
    }

