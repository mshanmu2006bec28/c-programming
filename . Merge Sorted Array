void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    // Set pointers to the last valid elements and the write position
    int* p1 = nums1 + m - 1;        // Points to the end of valid numbers in nums1
    int* p2 = nums2 + n - 1;        // Points to the end of nums2
    int* pWrite = nums1 + m + n - 1; // Points to the very end of nums1 memory block

    // Merge from back to front while elements remain in both windows
    while (p1 >= nums1 && p2 >= nums2) {
        if (*p1 > *p2) {
            *pWrite = *p1;
            p1--;
        } else {
            *pWrite = *p2;
            p2--;
        }
        pWrite--;
    }

    // If nums1 runs out first, exhaust any remaining elements in nums2
    while (p2 >= nums2) {
        *pWrite = *p2;
        p2--;
        pWrite--;
    }
}
