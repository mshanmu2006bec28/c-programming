#include <stdio.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int arrayNesting(int* nums, int numsSize) {
    int maxLength = 0;

    for (int i = 0; i < numsSize; i++) {
        // If the element has already been visited (-1), skip it
        if (*(nums + i) == -1) continue;

        int current = i;
        int currentLength = 0;

        // Traverse the mutually exclusive loop/cycle
        while (*(nums + current) != -1) {
            int next = *(nums + current);
            *(nums + current) = -1; // Mark the node as visited in-place
            current = next;         // Step forward to the next index
            currentLength++;
        }

        // Keep track of the longest nested cycle set found
        maxLength = MAX(maxLength, currentLength);
    }

    return maxLength;
}
