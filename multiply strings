#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* multiply(char* num1, char* num2) {
    // Edge case: if either number is "0", the product is "0"
    if (strcmp(num1, "0") == 0 || strcmp(num2, "0") == 0) {
        char* zero = (char*)malloc(2 * sizeof(char));
        strcpy(zero, "0");
        return zero;
    }

    int len1 = strlen(num1);
    int len2 = strlen(num2);
    int totalLen = len1 + len2;
    
    // Allocate space for the result array (initialized to 0)
    int* result = (int*)calloc(totalLen, sizeof(int));
    if (result == NULL) return NULL;

    // Multiply each digit and add to the matching position in the result array
    for (int i = len1 - 1; i >= 0; i--) {
        for (int j = len2 - 1; j >= 0; j--) {
            int digit1 = num1[i] - '0';
            int digit2 = num2[j] - '0';
            
            // The product of digits at index i and j contributes to positions i + j and i + j + 1
            int mul = digit1 * digit2;
            int p1 = i + j;
            int p2 = i + j + 1;

            int sum = mul + result[p2];
            result[p2] = sum % 10;   // Keep the remainder at position p2
            result[p1] += sum / 10;  // Carry over the value to position p1
        }
    }

    // Allocate memory for the final output string
    char* resultStr = (char*)malloc((totalLen + 1) * sizeof(char));
    if (resultStr == NULL) {
        free(result);
        return NULL;
    }

    int index = 0;
    int i = 0;
    
    // Skip any leading zeros that remained unfilled
    while (i < totalLen && result[i] == 0) {
        i++;
    }

    // Copy the remaining digits into the character array
    while (i < totalLen) {
        resultStr[index++] = result[i++] + '0';
    }
    
    // Null-terminate the string
    resultStr[index] = '\0';

    free(result);
    return resultStr;
}
