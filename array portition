#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort using pointer dereferencing
int compare(const void* a, const void* b) {
    return (*(const int*)a - *(const int*)b);
}

int arrayPairSum(int* nums, int numsSize) {
    // 1. Sort the array in ascending order in-place
    qsort(nums, numsSize, sizeof(int), compare);
    
    int sum = 0;
    
    // 2. Sum up every element at an even offset using pointer arithmetic
    for (int i = 0; i < numsSize; i += 2) {
        sum += *(nums + i);
    }
    
    return sum;
}
