int jump(int* nums, int numsSize) {
    // If the array has only 1 element, we are already at the destination.
    if (numsSize <= 1) {
        return 0;
    }

    int jumps = 0;
    int current_jump_end = 0;
    int farthest_reachable = 0;

    // We don't need to check the last element because we stop once we can reach it.
    for (int i = 0; i < numsSize - 1; i++) {
        // Update the furthest index we can reach from the current range
        if (i + nums[i] > farthest_reachable) {
            farthest_reachable = i + nums[i];
        }

        // If we have reached the end of the current jump's reach,
        // we must make another jump and set the new boundary.
        if (i == current_jump_end) {
            jumps++;
            current_jump_end = farthest_reachable;

            // If our new reach extends to or past the last index, we can stop early.
            if (current_jump_end >= numsSize - 1) {
                break;
            }
        }
    }

    return jumps;
}
