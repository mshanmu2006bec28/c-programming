#include <stdio.h>

// Helper function to reverse an array segment using pointer syntax
void reverse(int* nums, int start, int end) {
    while (start < end) {
        int temp = *(nums + start);
        *(nums + start) = *(nums + end);
        *(nums + end) = temp;
        start++;
        end--;
    }
}

void rotate(int* nums, int numsSize, int k) {
    // Normalize k if it exceeds the size of the array
    k %= numsSize;
    if (k == 0) return;

    // 1. Reverse the entire array
    reverse(nums, 0, numsSize - 1);
    
    // 2. Reverse the first k elements
    reverse(nums, 0, k - 1);
    
    // 3. Reverse the remaining elements from index k to the end
    reverse(nums, k, numsSize - 1);
}
